# Copy to .env next to ask.py. The MCP server must already be running.

MCP_URL=http://127.0.0.1:8001/mcp
# Only if the server .env has MCP_SHARED_TOKEN set.
MCP_SHARED_TOKEN=

# openai or gemini
LLM_PROVIDER=openai

# --- OpenAI (LLM_PROVIDER=openai) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional, for an OpenAI-compatible endpoint:
# OPENAI_BASE_URL=

# --- Gemini (LLM_PROVIDER=gemini) --------------------------------------------
# Key from Google AI Studio. GEMINI_API_KEY also works.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
